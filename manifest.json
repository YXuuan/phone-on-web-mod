{
  "name": "Phone On Web 增强版 | Android in browser",
  "description": "用浏览器控制安卓手机（无需 root）：投屏、桌面版网页浏览、剪贴板双向同步、下载自动回传。",
  "homepage_url": "http://browserlify.com/?from=webstore_chrome",
  "version": "1.5.1",
  "manifest_version": 3,
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "downloads",
    "clipboardRead"
  ],
  "icons": {
    "64": "icons/icon_64.png",
    "96": "icons/icon_64.png",
    "128": "icons/icon_64.png"
  },
  "action": {
    "default_title": "Using android in browser"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
